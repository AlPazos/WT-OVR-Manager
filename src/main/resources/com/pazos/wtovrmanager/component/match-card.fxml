<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<fx:root type="VBox" xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1"
         styleClass="card-match" spacing="10">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label fx:id="lblMatchNumber" styleClass="label-match-number" text="-"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblRound" styleClass="label-subtitle" text=""/>
    </HBox>

    <!-- Scores -->
    <HBox alignment="CENTER" spacing="12">
        <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
            <Label fx:id="lblHomeName" styleClass="label-subtitle" text="-"/>
            <Label fx:id="lblHomeCountry" styleClass="label-section" text=""/>
            <Label fx:id="lblHomeScore" styleClass="label-score,label-score-blue" text="0"/>
        </VBox>
        <VBox alignment="CENTER" spacing="4">
            <Label fx:id="lblRoundTime" styleClass="label-clock" text="--:--"/>
        </VBox>
        <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
            <Label fx:id="lblAwayName" styleClass="label-subtitle" text="-"/>
            <Label fx:id="lblAwayCountry" styleClass="label-section" text=""/>
            <Label fx:id="lblAwayScore" styleClass="label-score,label-score-red" text="0"/>
        </VBox>
    </HBox>

    <!-- Footer -->
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label fx:id="lblStatus" styleClass="badge,badge-available" text="WAITING"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblPenalties" styleClass="label-subtitle" text=""/>
    </HBox>

</fx:root>
